# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
WORKBENCH_SESSION_SECRET=replace_with_min_32_char_random_secret
WORKBENCH_ADMIN_USER=admin
WORKBENCH_ADMIN_PASSWORD=replace_with_strong_password

# ── WebAuthn (passkeys) ───────────────────────────────────────────────────────
WEBAUTHN_RP_ID=clarionview.io
WEBAUTHN_RP_NAME=ClarionView
WEBAUTHN_ORIGIN=https://clarionview.io
SITE_URL=https://clarionview.io

# ── Next.js ───────────────────────────────────────────────────────────────────
# Leave empty for root deployment; set to /workbench for sub-path
NEXT_PUBLIC_BASE_PATH=

# ── Encryption ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
WORKBENCH_BYOK_ENCRYPTION_KEY=replace_with_64_char_hex_key

# ── LLM providers ─────────────────────────────────────────────────────────────
# Option A: OpenRouter (recommended for production)
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini
OPENROUTER_HTTP_REFERER=https://clarionview.io
OPENROUTER_APP_TITLE=ClarionView

# Option B: Local Ollama fallback (used when OPENROUTER_API_KEY is empty)
LOCAL_LLM_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=gemma3:4b
LOCAL_LLM_API_KEY=ollama

# ── Data ─────────────────────────────────────────────────────────────────────
FRED_API_KEY=

# ── Scheduler ─────────────────────────────────────────────────────────────────
REPORT_HOUR_UTC=2
